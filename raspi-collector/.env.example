# ── Device ────────────────────────────────────────────────────────────────────
# Unique identifier for this device; used as the MQTT client ID and topic prefix.
# Topics published:
#   {DEVICE_ID}/sensors/chamber_effluent   — pH, water_temp, DO, TDS, EC
#   {DEVICE_ID}/sensors/blower_pump        — v1/i1/f1/pf1/p1/e1, v2/i2/…
#   {DEVICE_ID}/sensors/ambient            — amb_temp, amb_hum
# Topic subscribed (--mode subscriber):
#   {DEVICE_ID}/control/#
DEVICE_ID=rpi-001

# ── MQTT Broker ───────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# Leave blank if the broker requires no authentication
MQTT_USERNAME=
MQTT_PASSWORD=

# ── MQTT Options ──────────────────────────────────────────────────────────────
# QoS level: 0 = AtMostOnce  1 = AtLeastOnce  2 = ExactlyOnce
MQTT_QOS=1

# Keep-alive interval in seconds
MQTT_KEEP_ALIVE=60
