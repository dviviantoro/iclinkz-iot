# ── Image Capture & OCR ───────────────────────────────────────────────────────
# Cron schedule for image capture (default: every 6 hours)
CRON_TIME="0 */6 * * *"

# Camera backend: picamera (default) | webcam
CAMERA_SOURCE=picamera

# Webcam device node (only used when CAMERA_SOURCE=webcam)
WEBCAM_DEVICE=/dev/video0

# Groq API key for flowmeter OCR (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ── Simulate (cargo run --bin simulate) ───────────────────────────────────────
# How often the simulator publishes a new meter reading (minutes)
SIMULATE_INTERVAL_MINS=30

# Directory containing meter JSON files (relative to working directory)
METER_DATA_DIR=meter-data

# ── Device ────────────────────────────────────────────────────────────────────
# Unique identifier for this device; used as the MQTT client ID and topic prefix.
# Topics published:
#   {DEVICE_ID}/sensors/chamber_effluent   — pH, water_temp, DO, TDS, EC
#   {DEVICE_ID}/sensors/blower_pump        — v1/i1/f1/pf1/p1/e1, v2/i2/…
#   {DEVICE_ID}/sensors/ambient            — amb_temp, amb_hum
#   {DEVICE_ID}/meters/flowmeter           — brand, reading_m3, dn_mm, qn_m3h, pn_bar, max_temp_c, iso, timestamp
# Topic subscribed (--mode subscriber):
#   {DEVICE_ID}/control/#
DEVICE_ID=rpi-001

# ── MQTT Broker ───────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# Leave blank if the broker requires no authentication
MQTT_USERNAME=
MQTT_PASSWORD=

# ── MQTT Options ──────────────────────────────────────────────────────────────
# QoS level: 0 = AtMostOnce  1 = AtLeastOnce  2 = ExactlyOnce
MQTT_QOS=1

# Keep-alive interval in seconds
MQTT_KEEP_ALIVE=60
